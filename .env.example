# Copy to .env (git-ignored) and fill in. Never commit the real file.
# 32 random bytes, base64. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
AUDIT_ENCRYPTION_KEY=
AUDIT_KEY_ID=k1

# Host ports (compose publishes them on 127.0.0.1 only)
API_PORT=4380
DEMO_PORT=4381

# Only used by the non-production `api-demo` service (compose profile "demo"/"test").
# At least 24 characters. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(24).toString('base64url'))"
DEMO_CONTROL_TOKEN=

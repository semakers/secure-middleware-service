[219.797459, "o", " \u001b[32m✓\u001b[39m \u001b[30m\u001b[45m integration \u001b[49m\u001b[39m tests/integration/validation.test.ts \u001b[2m(\u001b[22m\u001b[2m28 tests\u001b[22m\u001b[2m)\u001b[22m\u001b[33m 4231\u001b[2mms\u001b[22m\u001b[39m\r\n   \u001b[32m✓\u001b[39m validation (400) \u001b[2m(19)\u001b[22m\r\n     \u001b[33m\u001b[2m✓\u001b[22m\u001b[39m does not let the body choose a failure mode\u001b[33m 2018\u001b[2mms\u001b[22m\u001b[39m\r\n   \u001b[32m✓\u001b[39m transport errors \u001b[2m(9)\u001b[22m\r\n     \u001b[33m\u001b[2m✓\u001b[22m\u001b[39m 415 for a non-UTF-8 charset and for a compressed body\u001b[33m 2027\u001b[2mms\u001b[22m\u001b[39m\r\n \u001b[32m✓\u001b[39m \u001b[30m\u001b[45m integration \u001b[49m\u001b[39m tests/integration/concurrency-and-failure.test.ts \u001b[2m(\u001b[22m\u001b[2m6 tests\u001b[22m\u001b[2m | \u001b[22m\u001b[33m5 skipped\u001b[39m\u001b[2m)\u001b[22m\u001b[33m 2085\u001b[2mms\u001b[22m\u001b[39m\r\n   \u001b[32m✓\u001b[39m concurrency \u001b[2m(1)\u001b[22m\r\n     \u001b[33m\u001b[2m✓\u001b[22m\u001b[39m 25 concurrent requests -> 25 responses and 25 new valid audit records\u001b[33m 2056\u001b[2mms\u001b[22m\u001b[39m\r\n \u001b[32m✓\u001b[39m \u001b[30m\u001b[45m integration \u001b[49m\u001b[39m tests/integration/demo-control.test.ts \u001b[2m(\u001b[22m\u001b[2m6 tests\u001b[22m\u001b[2m)\u001b[22m\u001b[32m 53\u001b[2mms\u001b[22m\u001b[39m\r\n \u001b[32m✓\u001b[39m \u001b[30m\u001b[45m integration \u001b[49m\u001b[39m tests/integration/happy-path.test.ts \u001b[2m(\u001b[22m\u001b[2m6 tests\u001b[22m\u001b[2m | \u001b[22m\u001b[33m1 skipped\u001b[39m\u001b[2m)\u001b[22m\u001b[33m 8191\u001b[2mms\u001b[22m\u001b[39m\r\n   \u001b[32m✓\u001b[39m POST /secure-inquiry happy path \u001b[2m(6)\u001b[22m\r\n     \u001b[33m\u001b[2m✓\u001b[22m\u001b[39m redacts email + card + SSN and answers\u001b[33m 2019\u001b[2mms\u001b[22m\u001b[39m\r\n     \u001b[33m\u001b[2m✓\u001b[22m\u001b[39m leaves a clean message untouched and counts zero redactions\u001b[33m 2026\u001b[2mms\u001b[22m\u001b[39m\r\n     \u001b[33m\u001b[2m✓\u001b[22m\u001b[39m writes an encrypted audit record: original decrypts, redacted text is plaintext, no raw PII on disk\u001b[33m 2042\u001b[2mms\u001b[22m\u001b[39m\r\n     \u001b[33m\u001b[2m✓\u001b[22m\u001b[39m uses a unique IV for every record\u001b[33m 2070\u001b[2mms\u001b[22m\u001b[39m\r\n \u001b[32m✓\u001b[39m \u001b[30m\u001b[45m integration \u001b[49m\u001b[39m tests/integration/circuit-breaker.test.ts \u001b[2m(\u001b[22m\u001b[2m4 tests\u001b[22m\u001b[2m)\u001b[22m\u001b[33m 61467\u001b[2mms\u001b[22m\u001b[39m\r\n   \u001b[32m✓\u001b[39m circuit breaker over HTTP \u001b[2m(4)\u001b[22m\r\n     \u001b[33m\u001b[2m✓\u001b[22m\u001b[39m opens after N failures: 502 x3 (slow), then a fast 503 Service Busy with Retry-After\u001b[33m 6086\u001b[2mms\u001b[22m\u001b[39m\r\n     \u001b[33m\u001b[2m✓\u001b[22m\u001b[39m half-open: a failing trial re-opens the circuit, a healthy trial closes it\u001b[33m 44216\u001b[2mms\u001b[22m\u001b[39m\r\n     \u001b[33m\u001b[2m✓\u001b[22m\u001b[39m a hanging upstream is cut at the timeout: 504 AI_TIMEOUT, counted as a failure\u001b[33m 5046\u001b[2mms\u001b[22m\u001b[39m\r\n     \u001b[33m\u001b[2m✓\u001b[22m\u001b[39m a success resets the failure counter\u001b[33m 6087\u001b[2mms\u001b[22m\u001b[39m\r\n\u001b[2m Test Files \u001b[22m \u001b[1m\u001b[32m5 passed\u001b[39m\u001b[22m\u001b[90m (5)\u001b[39m\r\n\u001b[2m      Tests \u001b[22m \u001b[1m\u001b[32m44 passed\u001b[39m\u001b[22m\u001b[2m | \u001b[22m\u001b[33m6 skipped\u001b[39m\u001b[90m (50)\u001b[39m\r\n\u001b[2m   Duration \u001b[22m 77.60s\u001b[2m (tests 99%, import 1%)\u001b[22m\r\n"]
